      "context": "class EventJournal:\n    def append(self, event):\n        encoded = encode_event(event)\n        checksum = checksum_bytes(encoded)\n        frame = encode_length(len(encoded)) + encoded + checksum\n        self.file.write(frame)\n        self.file.flush()\n\n",
